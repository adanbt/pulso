function endWorkout(kind){const a=st.active;if(!a||a.kind!==kind)return;if(kind==='strength'){
 const finished=a.exercises.map(e=>({id:e.id,sets:e.sets.filter(s=>s.done&&!s.warmup).map(s=>({kg:Number(s.kg)||0,reps:Number(s.reps)}))})).filter(e=>e.sets.length);
 if(!finished.length){toast('Marca al menos una serie de trabajo.');return}
 if(finished.reduce((n,x)=>n+x.sets.length,0)<totalSets()&&!confirm('Hay series pendientes. ¿Finalizar igualmente?'))return;
 st.history.push({id:Date.now(),kind,date:a.date,routineId:a.routineId,exercises:finished,z2:{type:a.z2.type,duration:Number(a.z2.duration)||0,hr:a.z2.hr,pain:Number(a.z2.pain)||0},duration:Math.round((Date.now()-a.startTime)/60000)});
 }else{
 if(!Number(a.cardio.duration)||Number(a.cardio.duration)<1){toast('Indica una duración válida.');return}
 st.history.push({id:Date.now(),kind,date:a.date,cardio:{...a.cardio},duration:Number(a.cardio.duration),pain:Number(a.cardio.pain)||0});
 }
 st.active=null;persist();view='progress';render();window.scrollTo(0,0);toast('Entrenamiento guardado. Buen trabajo.');
}
function updateActiveField(field,value,dataset){if(!st.active)return;const a=st.active;if(field==='set-kg'||field==='set-reps'){const se=a.exercises[+dataset.ex]?.sets[+dataset.set];if(!se)return;se[field==='set-kg'?'kg':'reps']=value}
 else if(field.startsWith('z2-'))a.z2[field.slice(3)]=value;
 else if(field.startsWith('cardio-'))a.cardio[field.slice(7)]=value;
 persist()}
function tick(){const a=st.active;if(!a||view!=='session')return;const elapsed=$('#elapsed-label');if(elapsed)elapsed.textContent=formatTime(Math.floor((Date.now()-a.startTime)/1000))+' transcurridos';const count=$('#rest-counter');if(a.restUntil){const left=Math.max(0,Math.ceil((a.restUntil-Date.now())/1000));if(count)count.textContent=formatTime(left);if(left===0){a.restUntil=0;persist();const target=$('#rest-target');if(target)target.innerHTML='';if(!restExpired){restExpired=true;toast('Descanso terminado. Puedes iniciar la siguiente serie.');sound()} }} }
function sound(){try{const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio)return;const ctx=new Audio(),o=ctx.createOscillator(),g=ctx.createGain();o.frequency.value=640;g.gain.value=.09;o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+.14);o.onended=()=>ctx.close()}catch(e){}}
function compressPhoto(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>{const im=new Image();im.onload=()=>{const max=1000,ratio=Math.min(1,max/Math.max(im.naturalWidth,im.naturalHeight)),can=document.createElement('canvas');can.width=Math.max(1,Math.round(im.naturalWidth*ratio));can.height=Math.max(1,Math.round(im.naturalHeight*ratio));can.getContext('2d').drawImage(im,0,0,can.width,can.height);resolve(can.toDataURL('image/jpeg',.72))};im.onerror=()=>reject(new Error('No se pudo procesar la imagen'));im.src=reader.result};reader.onerror=()=>reject(reader.error);reader.readAsDataURL(file)})}
async function exportData(){try{await persistNow();const pkg={format:'pulso-backup-v1',exportedAt:new Date().toISOString(),state:st,photos},blob=new Blob([JSON.stringify(pkg)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`pulso-respaldo-${tdy()}.json`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);toast('Respaldo generado. Guárdalo fuera de esta app.')}catch(e){toast('Error al exportar: '+e.message)}}
async function importData(file){try{if(!file||file.size>70*1024*1024)throw new Error('Archivo ausente o demasiado grande');const obj=JSON.parse(await file.text());if(obj.format!=='pulso-backup-v1'||!obj.state?.settings||!Array.isArray(obj.state.history)||!Array.isArray(obj.photos))throw new Error('No es un respaldo PULSO válido');if(!confirm('Restaurar reemplazará todos los registros de este dispositivo. ¿Continuar?'))return;
 const tx=db.transaction(['data','photos'],'readwrite');tx.objectStore('photos').clear();for(const p of obj.photos){if(typeof p.id==='number'&&typeof p.dataUrl==='string'&&p.dataUrl.startsWith('data:image/jpeg;base64,')&&p.dataUrl.length<8e6)tx.objectStore('photos').put(p)}tx.objectStore('data').put(obj.state,'state');await new Promise((res,rej)=>{tx.oncomplete=res;tx.onerror=()=>rej(tx.error)});st=obj.state;photos=await dbAll('photos');selectedWeek=thisWeek();view='home';render();closeModal();toast('Respaldo restaurado.')}catch(e){toast('No se pudo restaurar: '+e.message)}}
async function resetEverything(){if(!confirm('¿Eliminar TODOS los registros, pesos y fotografías de este iPhone?')||!confirm('Confirma de nuevo: esta acción no se puede deshacer.'))return;await dbDelete('data','state');const tx=db.transaction('photos','readwrite');tx.objectStore('photos').clear();await new Promise(res=>tx.oncomplete=res);st=fresh();photos=[];view='home';selectedWeek=thisWeek();render();toast('Datos locales eliminados.')}
function choosePreset(preset){const cfg=structuredClone(st.weekConfig[selectedWeek]||st.availability);if(preset==='normal'){for(const day of [1,3,5])cfg[day]={minutes:90,pref:'strength'};for(const day of [2,4])cfg[day]={minutes:45,pref:'cardio'};for(const day of [0,6])cfg[day]={minutes:0,pref:'auto'}}else{for(const day of [1,2,3,4,5,6,0])cfg[day]={minutes:0,pref:'auto'};cfg[2]={minutes:60,pref:'strength'};cfg[4]={minutes:60,pref:'strength'};cfg[6]={minutes:40,pref:'cardio'}}st.weekConfig[selectedWeek]=cfg;autoPlan(selectedWeek);render();toast('Disponibilidad actualizada.')}
function nav(to){view=to;window.scrollTo({top:0,behavior:'instant'});render()}
async function dispatch(action,el){const d=el.dataset;
 switch(action){
 case 'nav':nav(d.view);break;
 case 'goto-session':nav('session');break;
 case 'start-home':{const n=suggestNext(),today=tdy();if(n.date!==today){const oldWeek=weekStart(parseDate(n.date)),nowWeek=thisWeek();planFor(nowWeek);st.plans[oldWeek][n.date]={type:'rest',minutes:0,auto:false};st.plans[nowWeek][today]={...n.p,auto:false};persist()}await startSession(today,n.p.type==='cardio'?'cardio':n.p.routineId,n.p.minutes);break}
 case 'start-plan':{const p=actualSession(d.date);if(st.active){closeModal();nav('session');toast('Ya tienes un entrenamiento en curso.');break}if(p.type==='rest')break;closeModal();await startSession(d.date,p.type==='cardio'?'cardio':p.routineId,p.minutes);break}
 case 'manual-start':await startSession(tdy(),d.routine,90);break;
 case 'quick-cardio':await startSession(tdy(),'cardio',45);break;
 case 'quick-weight':weightModal();break;
 case 'save-weight':{const value=Number($('#weight-value').value),date=$('#weight-date').value;if(!Number.isFinite(value)||value<30||value>250||!/^\d{4}-\d\d-\d\d$/.test(date)){toast('Revisa el peso y la fecha.');break}st.weights.push({id:Date.now(),date,kg:value});st.weights.sort((a,b)=>a.date.localeCompare(b.date));persist();closeModal();render();toast('Medición guardada.');break}
 case 'add-photo':photoModal();break;
 case 'save-photo':{const file=$('#photo-input')?.files?.[0],date=$('#photo-date')?.value;if(!file||!file.type.startsWith('image/')){toast('Selecciona una imagen.');break}if(file.size>25*1024*1024){toast('Imagen demasiado grande (máximo 25 MB).');break}try{const dataUrl=await compressPhoto(file),p={id:Date.now(),date,dataUrl};await dbPut('photos',p);photos.push(p);closeModal();render();toast('Foto guardada localmente.')}catch(e){toast(e.message)}break}
 case 'photo-view':photoView(d.id);break;
 case 'delete-photo':if(confirm('¿Eliminar definitivamente esta fotografía?')){await dbDelete('photos',Number(d.id));photos=photos.filter(p=>String(p.id)!==String(d.id));closeModal();render();toast('Foto eliminada.')}break;
 case 'history-detail':historyModal(d.id);break;
 case 'delete-history':if(confirm('¿Eliminar esta sesión del historial?')){st.history=st.history.filter(x=>String(x.id)!==String(d.id));persist();closeModal();render();toast('Sesión eliminada.')}break;
 case 'exercise-info':exerciseModal(d.id);break;
 case 'swap':swapModal(Number(d.index));break;
 case 'choose-swap':{const it=st.active.exercises[+d.index];if(it.sets.some(s=>s.done)&&!confirm('Este ejercicio tiene series completadas. ¿Sustituirlo y descartar esas series?'))break;st.active.exercises[+d.index]=createEx(d.id,st.active.limit<=60);persist();closeModal();render();toast('Ejercicio sustituido.');break}
 case 'move-exercise':{const i=+d.index,j=i+Number(d.dir),arr=st.active.exercises;if(j>=0&&j<arr.length){[arr[i],arr[j]]=[arr[j],arr[i]];persist();render()}break}
 case 'change-rest':{const it=st.active.exercises[+d.index];modal(`<div class="eyebrow">DESCANSO POR EJERCICIO</div><h2 class="title" style="font-size:24px">${esc(exercise(it.id).name)}</h2><div class="field"><label>Segundos entre series</label><select id="rest-value">${[45,60,75,90,120,150,180,240].map(n=>`<option value="${n}" ${it.rest===n?'selected':''}>${n}s</option>`).join('')}</select></div><button class="btn btn-primary btn-block" style="margin-top:15px" data-action="save-rest" data-index="${d.index}">Guardar descanso</button>`);break}
 case 'save-rest':st.active.exercises[+d.index].rest=Number($('#rest-value').value);persist();closeModal();render();break;
 case 'toggle-set':{const it=st.active.exercises[+d.ex],se=it.sets[+d.set];if(!se.done&&(!se.reps||Number(se.reps)<=0)){toast('Introduce las repeticiones antes de completar.');break}se.done=!se.done;if(se.done&&!se.warmup){st.active.restUntil=Date.now()+it.rest*1000;restExpired=false}else if(!se.done)st.active.restUntil=0;persist();render();break}
 case 'rest-plus':st.active.restUntil+=15000;persist();tick();break;
 case 'rest-minus':st.active.restUntil=Math.max(Date.now(),st.active.restUntil-15000);persist();tick();break;
 case 'rest-stop':st.active.restUntil=0;persist();$('#rest-target').innerHTML='';break;
 case 'finish-strength':endWorkout('strength');break;
 case 'finish-cardio':endWorkout('cardio');break;
 case 'cancel-session':if(confirm('¿Descartar esta sesión sin guardarla en el historial?')){st.active=null;persist();nav('home')}break;
 case 'week-shift':selectedWeek=iso(addDays(parseDate(selectedWeek),Number(d.n)));render();break;
 case 'go-current-week':selectedWeek=thisWeek();render();break;
 case 'autoplan':autoPlan(selectedWeek);render();toast('Plan reorganizado según tu tiempo.');break;
 case 'preset-week':choosePreset(d.preset);break;
 case 'day-detail':dayModal(d.date);break;
 case 'save-day':{const v=$('#modal-day-type').value,w=weekStart(parseDate(d.date)),old=actualSession(d.date),p=v==='rest'?{type:'rest',minutes:0,auto:false}:v==='cardio'?{type:'cardio',minutes:old.minutes||45,auto:false}:{type:'strength',routineId:v,minutes:old.minutes||90,auto:false};st.plans[w][d.date]=p;persist();closeModal();render();toast('Día actualizado.');break}
 case 'close-modal':closeModal();break;
 case 'export-data':await exportData();break;
 case 'import-data':$('#import-file').click();break;
 case 'reset-data':await resetEverything();break;
 }
}
