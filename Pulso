function exerciseModal(id){const x=exercise(id);if(!x)return;const alternatives=DATA.exercises.filter(e=>e.id!==x.id&&e.muscle===x.muscle).slice(0,5);modal(`<div class="eyebrow">TÉCNICA DE EJERCICIO</div><h2 class="title" style="font-size:24px">${esc(x.name)}</h2><p class="small muted">${esc(x.muscle)} · ${esc(x.equipment)}</p><div class="diagram-pair"><img src="assets/exercises/${x.id}-1.svg" alt="Posición inicial de ${esc(x.name)}"/><img src="assets/exercises/${x.id}-2.svg" alt="Posición final de ${esc(x.name)}"/></div><h3 class="h3" style="margin:16px 0 7px">Cómo ejecutarlo</h3><p class="small paragraph">${esc(x.cue)}</p><div class="tip"><strong>Evita:</strong> ${esc(x.avoid)}</div><h3 class="h3" style="margin:17px 0 8px">Alternativas del mismo grupo</h3>${alternatives.length?alternatives.map(a=>`<button class="btn btn-secondary btn-block" style="justify-content:space-between;margin-top:6px" data-action="exercise-info" data-id="${a.id}">${esc(a.name)} <span>›</span></button>`).join(''):'<p class="small muted">Sin alternativas en este catálogo inicial.</p>'}<p class="footer-note">Diagramas esquemáticos: complementa con la supervisión de tu gimnasio cuando aprendas un movimiento nuevo.</p>`)}
